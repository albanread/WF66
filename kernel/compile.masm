endp()

; inline-2>r,  ( xt -- )
;     Emit 2>R directly into the current definition.
proc(inline_two_to_r_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0xFF          ; push qword [rbp]
    mov     byte ptr [r8 + 1], 0x75
    mov     byte ptr [r8 + 2], 0x00
    mov     byte ptr [r8 + 3], 0x50          ; push rax
    mov     byte ptr [r8 + 4], 0x48          ; mov rax, [rbp+8]
    mov     byte ptr [r8 + 5], 0x8B
    mov     byte ptr [r8 + 6], 0x45
    mov     byte ptr [r8 + 7], 0x08
    mov     byte ptr [r8 + 8], 0x48          ; add rbp, 16
    mov     byte ptr [r8 + 9], 0x83
    mov     byte ptr [r8 + 10], 0xC5
    mov     byte ptr [r8 + 11], 0x10
    add     r8, 12
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-2r>,  ( xt -- )
;     Emit 2R> directly into the current definition.
proc(inline_two_r_from_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; sub rbp, 16
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xED
    mov     byte ptr [r8 + 3], 0x10
    mov     byte ptr [r8 + 4], 0x48          ; mov [rbp+8], rax
    mov     byte ptr [r8 + 5], 0x89
    mov     byte ptr [r8 + 6], 0x45
    mov     byte ptr [r8 + 7], 0x08
    mov     byte ptr [r8 + 8], 0x58          ; pop rax
    mov     byte ptr [r8 + 9], 0x8F          ; pop qword ptr [rbp]
    mov     byte ptr [r8 + 10], 0x45
    mov     byte ptr [r8 + 11], 0x00
    add     r8, 12
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-2r@,  ( xt -- )
;     Emit 2R@ directly into the current definition.
proc(inline_two_r_fetch_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; sub rbp, 16
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xED
    mov     byte ptr [r8 + 3], 0x10
    mov     byte ptr [r8 + 4], 0x48          ; mov [rbp+8], rax
    mov     byte ptr [r8 + 5], 0x89
    mov     byte ptr [r8 + 6], 0x45
    mov     byte ptr [r8 + 7], 0x08
    mov     byte ptr [r8 + 8], 0x48          ; mov rdx, [rsp+8]
    mov     byte ptr [r8 + 9], 0x8B
    mov     byte ptr [r8 + 10], 0x54
    mov     byte ptr [r8 + 11], 0x24
    mov     byte ptr [r8 + 12], 0x08
    mov     byte ptr [r8 + 13], 0x48         ; mov rax, [rsp]
    mov     byte ptr [r8 + 14], 0x8B
    mov     byte ptr [r8 + 15], 0x04
    mov     byte ptr [r8 + 16], 0x24
    mov     byte ptr [r8 + 17], 0x48         ; mov [rbp], rdx
    mov     byte ptr [r8 + 18], 0x89
    mov     byte ptr [r8 + 19], 0x55
    mov     byte ptr [r8 + 20], 0x00
    add     r8, 21
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-rdrop,  ( xt -- )
;     Emit RDROP inline: drop one cell from the return stack.  As a CALLED
;     primitive rdrop must juggle its own return address (pop/add/push); inline
;     there is no return address on top, so it is a single `add rsp, 8`.  This
;     also removes the compile_comma_no_tco guard rdrop needed as a CALL (no
;     call means nothing for ; / EXIT to mis-patch into a JMP).
proc(inline_rdrop_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; add rsp, 8
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC4
    mov     byte ptr [r8 + 3], 0x08
    add     r8, 4
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-2rdrop,  ( xt -- )
;     Emit 2RDROP inline: drop two cells from the return stack (`add rsp, 16`).
proc(inline_two_rdrop_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; add rsp, 16
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC4
    mov     byte ptr [r8 + 3], 0x10
    add     r8, 4
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-i,  ( xt -- )
;     Emit I directly into the current definition.
proc(inline_i_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov [rbp-8], rax
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0xF8
    mov     byte ptr [r8 + 4], 0x48          ; mov rax, [rsp]
    mov     byte ptr [r8 + 5], 0x8B
    mov     byte ptr [r8 + 6], 0x04
    mov     byte ptr [r8 + 7], 0x24
    mov     byte ptr [r8 + 8], 0x48          ; add rax, [rsp+8]
    mov     byte ptr [r8 + 9], 0x03
    mov     byte ptr [r8 + 10], 0x44
    mov     byte ptr [r8 + 11], 0x24
    mov     byte ptr [r8 + 12], 0x08
    mov     byte ptr [r8 + 13], 0x48         ; sub rbp, 8
    mov     byte ptr [r8 + 14], 0x83
    mov     byte ptr [r8 + 15], 0xED
    mov     byte ptr [r8 + 16], 0x08
    add     r8, 17
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-j,  ( xt -- )
;     Emit J directly into the current definition.
proc(inline_j_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov [rbp-8], rax
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0xF8
    mov     byte ptr [r8 + 4], 0x48          ; mov rax, [rsp+16]
    mov     byte ptr [r8 + 5], 0x8B
    mov     byte ptr [r8 + 6], 0x44
    mov     byte ptr [r8 + 7], 0x24
    mov     byte ptr [r8 + 8], 0x10
    mov     byte ptr [r8 + 9], 0x48          ; add rax, [rsp+24]
    mov     byte ptr [r8 + 10], 0x03
    mov     byte ptr [r8 + 11], 0x44
    mov     byte ptr [r8 + 12], 0x24
    mov     byte ptr [r8 + 13], 0x18
    mov     byte ptr [r8 + 14], 0x48         ; sub rbp, 8
    mov     byte ptr [r8 + 15], 0x83
    mov     byte ptr [r8 + 16], 0xED
    mov     byte ptr [r8 + 17], 0x08
    add     r8, 18
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-do-part1,  ( xt -- )
;     Emit WF32's first loop-frame setup half directly into the definition.
proc(inline_do_part1_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov rdx, rax
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0xC2
    mov     byte ptr [r8 + 3], 0x48          ; mov rcx, [rbp]
    mov     byte ptr [r8 + 4], 0x8B
    mov     byte ptr [r8 + 5], 0x4D
    mov     byte ptr [r8 + 6], 0x00
    mov     byte ptr [r8 + 7], 0x48          ; mov rax, [rbp+8]
    mov     byte ptr [r8 + 8], 0x8B
    mov     byte ptr [r8 + 9], 0x45
    mov     byte ptr [r8 + 10], 0x08
    mov     byte ptr [r8 + 11], 0x48         ; add rbp, 16
    mov     byte ptr [r8 + 12], 0x83
    mov     byte ptr [r8 + 13], 0xC5
    mov     byte ptr [r8 + 14], 0x10
    add     r8, 15
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-do-part2,  ( xt -- )
;     Emit WF32's second loop-frame setup half directly into the definition.
proc(inline_do_part2_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x49          ; mov r8, 1
    mov     byte ptr [r8 + 1], 0xC7
    mov     byte ptr [r8 + 2], 0xC0
    mov     dword ptr [r8 + 3], 1
    mov     byte ptr [r8 + 7], 0x49          ; shl r8, 63
    mov     byte ptr [r8 + 8], 0xC1
    mov     byte ptr [r8 + 9], 0xE0
    mov     byte ptr [r8 + 10], 0x3F
    mov     byte ptr [r8 + 11], 0x4C         ; add rcx, r8
    mov     byte ptr [r8 + 12], 0x01
    mov     byte ptr [r8 + 13], 0xC1
    mov     byte ptr [r8 + 14], 0x48         ; sub rdx, rcx
    mov     byte ptr [r8 + 15], 0x29
    mov     byte ptr [r8 + 16], 0xCA
    mov     byte ptr [r8 + 17], 0x51         ; push rcx
    mov     byte ptr [r8 + 18], 0x52         ; push rdx
    add     r8, 19
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; bra  ( -- )  [compile-only runtime stub]
proc(bra_word)
    jmp     comp_only_word
endp()

; mark>  ( -- addr )
;     Return the current HERE value. WF32 uses this as the mark carried on
;     the compile-time control-flow stack; for rel32 branches it is the
;     address just past the instruction's displacement field.
proc(mark_to)
    mov     [DSP - cell], TOS
    mov     TOS, [UP + user_HERE]
    stk(0, 1)
    next()
endp()

; <resolve  ( dest -- )
;     Patch the rel32 field of the most recently emitted branch so it jumps
;     backward to dest. The field starts 4 bytes before HERE.
proc(back_resolve)
    mov     r8, [UP + user_HERE]
    sub     TOS, r8
    mov     dword ptr [r8 - 4], eax
    mov     rcx, [UP + user_OPT_FENCE]
    cmp     r8, rcx
    jbe     .fenced
    mov     [UP + user_OPT_FENCE], r8
.fenced:
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; >resolve  ( orig -- )
;     Patch the rel32 field at orig-4 so it jumps forward to the current HERE.
proc(forward_resolve)
    mov     rcx, TOS
    mov     r8, [UP + user_HERE]
    sub     r8, rcx
    mov     dword ptr [rcx - 4], r8d
    add     r8, rcx                          ; r8 = HERE (restore from offset+base)
    mov     rcx, [UP + user_OPT_FENCE]
    cmp     r8, rcx
    jbe     .fenced
    mov     [UP + user_OPT_FENCE], r8
.fenced:
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; ?pairs  ( n1 n2 -- )
;     THROW -22 if the control-flow marks differ; otherwise drop both.
proc(qpairs)
    mov     rcx, [DSP]
    xor     rcx, TOS
    jz      .ok
    mov     TOS, -22
    call    throw_word
    next()
.ok:
    mov     TOS, [DSP + cell]
    stk(2, 0)
    next()
endp()

; ahead  ( c: -- orig )                                   IMMEDIATE
;     Compile an unresolved forward branch and leave its mark pair.
proc(ahead_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0xE9
    mov     dword ptr [r8 + 1], 0
    add     r8, 5
    mov     [UP + user_HERE], r8
    call    mark_to
    mov     [DSP - cell], TOS
    mov     TOS, -1
    stk(0, 1)
    next()
endp()

; if  ( c: -- orig )  ( x -- )                            IMMEDIATE
proc(if_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    ; Compare→branch fusion: if the most recent emission was a cmp+setcc
    ; comparison, drop its 9-byte boolean materialization and branch straight
    ; off the cmp's flags with the inverted condition (if takes the branch when
    ; the condition is FALSE).  Saves ~6 instructions + ~12 bytes per condition.
    mov     r8, [UP + user_HERE]
    cmp     r8, [UP + user_LAST_CMP_END]
    jne     .normal
    mov     rcx, [UP + user_LAST_CMP_REWIND]
    cmp     rcx, [UP + user_OPT_FENCE]       ; never rewind across a resolved label
    jb      .normal
    mov     r8, rcx                          ; r8 = just past the cmp
    call    emit_drop_jcc                    ; emit mov/lea/jcc; r8 advanced past it
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     qword ptr [UP + user_LAST_CMP_END], 0   ; consume the comparison
    call    mark_to
    mov     [DSP - cell], TOS
    mov     TOS, -1
    stk(0, 1)
    next()
.normal:
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC5
    mov     byte ptr [r8 + 3], 0x08
    mov     byte ptr [r8 + 4], 0x48
    mov     byte ptr [r8 + 5], 0x85
    mov     byte ptr [r8 + 6], 0xC0
    mov     byte ptr [r8 + 7], 0x48
    mov     byte ptr [r8 + 8], 0x8B
    mov     byte ptr [r8 + 9], 0x45
    mov     byte ptr [r8 + 10], 0xF8
    mov     byte ptr [r8 + 11], 0x0F
    mov     byte ptr [r8 + 12], 0x84
    mov     dword ptr [r8 + 13], 0
    add     r8, 17
    mov     [UP + user_HERE], r8
    call    mark_to
    mov     [DSP - cell], TOS
    mov     TOS, -1
    stk(0, 1)
    next()
endp()

; (private) emit_drop_jcc  -- shared compare-fusion tail.
;     r8 = HERE write cursor (positioned just past the kept cmp).  Emits
;       mov rax,[rbp]    (raise NOS; preserves the cmp's flags)
;       lea rbp,[rbp+8]  (drop; lea, not add, so flags survive)
;       jcc rel32 0      (inverted condition, from user_LAST_CMP_SETCC)
;     and leaves r8 past the 14 emitted bytes (rel32 at [r8-4], unresolved).
;     Scratch: rcx. Does NOT touch TOS (rax) or user_HERE.
proc(emit_drop_jcc)
    mov     byte ptr [r8 + 0], 0x48          ; mov rax, [rbp]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0x00
    mov     byte ptr [r8 + 4], 0x48          ; lea rbp, [rbp + 8]
    mov     byte ptr [r8 + 5], 0x8D
    mov     byte ptr [r8 + 6], 0x6D
    mov     byte ptr [r8 + 7], 0x08
    mov     byte ptr [r8 + 8], 0x0F          ; jcc rel32
    movzx   ecx, byte ptr [UP + user_LAST_CMP_SETCC]
    sub     ecx, 0x10                        ; setcc 0x9x → jcc 0x8x
    xor     ecx, 1                           ; invert: branch when condition FALSE
    mov     byte ptr [r8 + 9], cl
    mov     dword ptr [r8 + 10], 0           ; rel32 placeholder (resolved by then/back)
    add     r8, 14
    ret
endp()

; -if  ( c: -- orig )  ( x -- x )                         IMMEDIATE
proc(minus_if_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x85
    mov     byte ptr [r8 + 2], 0xC0
    mov     byte ptr [r8 + 3], 0x0F
    mov     byte ptr [r8 + 4], 0x84
    mov     dword ptr [r8 + 5], 0
    add     r8, 9
    mov     [UP + user_HERE], r8
    call    mark_to
    mov     [DSP - cell], TOS
    mov     TOS, -1
    stk(0, 1)
    next()
endp()

; then  ( c: orig -- )                                    IMMEDIATE
proc(then_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    mov     [DSP - cell], TOS
    mov     TOS, -1
    stk(0, 1)
    call    qpairs
    call    forward_resolve
    next()
endp()

; else  ( c: orig1 -- orig2 )                             IMMEDIATE
proc(else_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    ahead_word
    call    two_swap
    call    then_word
    next()
endp()

; begin  ( c: -- dest )                                   IMMEDIATE
proc(begin_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    mark_to
    mov     [DSP - cell], TOS
    mov     TOS, -2
    stk(0, 1)
    call    pin_begin_maybe                  ; begin a record (indefinite loop)
    next()
endp()

; while  ( c: dest -- orig dest )  ( x -- )               IMMEDIATE
proc(while_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    if_word
    call    two_swap
    next()
endp()

; again  ( c: dest -- )                                   IMMEDIATE
proc(again_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    mov     [DSP - cell], TOS
    mov     TOS, -2
    stk(0, 1)
    call    qpairs
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0xE9
    mov     dword ptr [r8 + 1], 0
    add     r8, 5
    mov     [UP + user_HERE], r8
    call    back_resolve
    next()
endp()

; until  ( c: dest -- )  ( x -- )                         IMMEDIATE
proc(until_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    mov     [DSP - cell], TOS
    mov     TOS, -2
    stk(0, 1)
    call    qpairs                           ; TOS = dest (the begin mark)
    ; Compare→branch fusion (same as if, but the branch is backward to dest):
    ; loop again while the condition is FALSE, so use the inverted condition.
    mov     r8, [UP + user_HERE]
    cmp     r8, [UP + user_LAST_CMP_END]
    jne     .normal
    mov     rcx, [UP + user_LAST_CMP_REWIND]
    cmp     rcx, [UP + user_OPT_FENCE]
    jb      .normal
    mov     r8, rcx
    call    emit_drop_jcc                    ; mov/lea/jcc; r8 past it (TOS=dest survives)
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     qword ptr [UP + user_LAST_CMP_END], 0
    call    back_resolve                     ; patch the jcc rel32 to dest
    next()
.normal:
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC5
    mov     byte ptr [r8 + 3], 0x08
    mov     byte ptr [r8 + 4], 0x48
    mov     byte ptr [r8 + 5], 0x85
    mov     byte ptr [r8 + 6], 0xC0
    mov     byte ptr [r8 + 7], 0x48
    mov     byte ptr [r8 + 8], 0x8B
    mov     byte ptr [r8 + 9], 0x45
    mov     byte ptr [r8 + 10], 0xF8
    mov     byte ptr [r8 + 11], 0x0F
    mov     byte ptr [r8 + 12], 0x84
    mov     dword ptr [r8 + 13], 0
    add     r8, 17
    mov     [UP + user_HERE], r8
    call    back_resolve
    next()
endp()

; repeat  ( c: orig dest -- )                             IMMEDIATE
proc(repeat_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    again_word
    call    then_word
    next()
endp()

; recurse  ( -- )                                         IMMEDIATE
proc(recurse_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    latestxt
    call    compile_comma
    next()
endp()

; [  ( -- )                                               IMMEDIATE
;     Enter interpret state immediately.
proc(left_bracket_word)
    mov     qword ptr [UP + user_STATE], 0
    next()
endp()

; ]  ( -- )
;     Enter compile state.
proc(right_bracket_word)
    mov     qword ptr [UP + user_STATE], 1
    next()
endp()

; immediate  ( -- )
;     Make the most recently created word immediate by setting CT=EXECUTE.
proc(immediate_word)
    mov     rdi, [UP + user_LATEST]
    lea     r8, [rip + execute]
    mov     [rdi + dh_ct], r8
    next()
endp()

; '  ( -- xt )
;     Parse the next name and return its interpret xt.
proc(tick_word)
    call    parse_name
    test    TOS, TOS
    jnz     .got_name

    mov     TOS, [DSP + cell]
    add     DSP, 2*cell
    call    throw_namereqd_const
    call    throw_word
    next()

.got_name:
    call    find_name
    test    TOS, TOS
    jnz     .found

    mov     TOS, -13
    call    throw_word
    next()

.found:
    mov     TOS, [DSP]
    stk(1, 0)
    call    name_to_interpret
    next()
endp()

; [']  ( -<name>- )                                        IMMEDIATE
;     Compile the interpret xt of the next word as a literal.
proc(bracket_tick_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    tick_word
    call    literal
    next()
endp()

; literal  ( n -- )                                        IMMEDIATE
;     Compile the current TOS as a runtime literal.
proc(literal_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    literal
    next()
endp()

; fliteral  ( F: r -- )                                    IMMEDIATE
;     Compile the current floating-point top as a runtime literal.
proc(fliteral_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    fliteral
    next()
endp()

; s"  ( "ccc<quote>" -- c-addr u )                        IMMEDIATE
;     Compile or interpret a string literal.
;     Interpret: parse to closing " and leave ( c-addr u ) on the stack.
;       The c-addr points into the source buffer; valid until next REFILL.
;     Compile: emit call do_slit + inline bytes (standard sliteral).
proc(s_quote_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    ; Interpret mode: parse string, push (c-addr u) from source buffer.
    call    skip_optional_source_blank
    mov     [DSP - cell], TOS
    mov     TOS, 34                              ; delimiter = '"'
    stk(0, 1)
    call    parse_word                           ; ( -- c-addr u )
    next()
.in_compile:
    call    skip_optional_source_blank
    mov     [DSP - cell], TOS
    mov     TOS, 34
    stk(0, 1)
    call    parse_word
    call    sliteral
    next()
endp()

; ."  ( "ccc<quote>" -- )                                  IMMEDIATE
;     Interpret: parse string and type it immediately.
;     Compile: embed string literal and compile call to TYPE.
proc(dot_quote_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    skip_optional_source_blank
    mov     [DSP - cell], TOS
    mov     TOS, 34
    stk(0, 1)
    call    parse_word
    call    type_word
    next()
.in_compile:
    call    skip_optional_source_blank
    mov     [DSP - cell], TOS
    mov     TOS, 34
    stk(0, 1)
    call    parse_word
    call    sliteral
    lea     rcx, [rip + type_word]
    call    compile_xt_from_rcx
    next()
endp()

; c"  ( "ccc<quote>" -- c-addr )                           IMMEDIATE
;     Interpret: parse to closing " and leave a transient counted string.
;     Compile: emit call do_clit ; .byte len ; <len bytes> and leave the
;       counted string address at runtime.
proc(c_quote_word)
    call    skip_optional_source_blank
    mov     [DSP - cell], TOS
    mov     TOS, 34
    stk(0, 1)
    call    word_word                        ; ( -- c-addr ) counted string
    cmp     qword ptr [UP + user_STATE], 0
    je      .done
    call    cliteral
.done:
    next()
endp()

; abort"  ( "ccc<quote>" -- )                            IMMEDIATE
;     Compile: IF <inline-string> TYPE throw_abortq THROW THEN
;     The IF/THEN control-flow mark lives on the data stack during
;     compilation, so preserve it in registers while the string literal
;     helper uses the stack as scratch.
proc(abort_quote_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    if_word
    mov     r13, DSP
    mov     r14, TOS
    call    skip_optional_source_blank
    mov     [DSP - cell], TOS
    mov     TOS, 34
    stk(0, 1)
    call    parse_word
    call    sliteral
    lea     rcx, [rip + type_word]
    call    compile_xt_from_rcx
    lea     rcx, [rip + throw_abortq_const]
    call    compile_xt_from_rcx
    lea     rcx, [rip + throw_word]
    call    compile_xt_from_rcx
    mov     DSP, r13
    mov     TOS, r14
    call    then_word
    next()
endp()

; postpone  ( -<name>- )                                   IMMEDIATE
;     Compile the compilation semantics of the next parsed word.
proc(postpone_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    parse_name
    test    TOS, TOS
    jnz     .got_name

    mov     TOS, [DSP + cell]
    add     DSP, 2*cell
    call    throw_namereqd_const
    call    throw_word
    next()

.got_name:
    call    find_name
    test    TOS, TOS
    jnz     .found

    mov     TOS, -13
    call    throw_word
    next()

.found:
    mov     TOS, [DSP]
    stk(1, 0)
    call    name_to_compile                ; -> xt ct
    call    swap_                          ; -> ct xt
    call    literal                        ; compile xt as runtime literal, leave ct
    call    compile_comma                  ; compile call to ct
    next()
endp()

; Runtime helper for DOES>. Rewrites the most recently created word's
; stub tail from RET+padding to JMP does-body, preserving the body
; address push in the stub prefix.
;
; The DOES> stub puts the target address in RCX (Win64 arg-1,
; caller-saved) via `mov rcx, imm64(target)`, then `call`s here.
; RCX is NOT the cached TOS, so the user's data stack is untouched
; and we just do the patch and `ret` (no `next()` — we're in a
; sub-call from the stub, returning to the stub's own RET).
proc(does_runtime_patch)
    mov     r8, [UP + user_LATESTXT]            ; xt of latest created word
    lea     r9, [r8 + 23]                       ; IP after jmp rel32
    mov     byte ptr [r8 + 18], 0xE9            ; JMP rel32 opcode
    sub     rcx, r9                             ; rel32 = target - next_ip
    mov     dword ptr [r8 + 19], ecx
    ret
endp()

; does>  ( -- )                                        IMMEDIATE
;     End the create-time portion of a defining word. At runtime the
;     defining word patches the newest created word to jump into the
;     does-body, while created-word execution still pushes >BODY.
proc(does_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()

.in_compile:
    mov     r8, [UP + user_HERE]                ; patch-call sequence start
    lea     r9, [r8 + 16]                       ; target = code after ret

    ; mov rcx, imm64(target)  -- rcx is Win64 arg-1, caller-saved, and
    ; is NOT the cached TOS register, so this does not clobber the user's
    ; data stack the way `mov rax, ...` would.
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0xB9
    mov     qword ptr [r8 + 2], r9

    ; call does_runtime_patch
    mov     byte ptr [r8 + 10], 0xE8
    lea     r10, [rip + does_runtime_patch]
    lea     r11, [r8 + 15]
    sub     r10, r11
    mov     dword ptr [r8 + 11], r10d

    ; ret -- created words are patched during create-time execution;
    ; the does-body itself starts immediately after this return.
    mov     byte ptr [r8 + 15], 0xC3

    lea     r8, [r8 + 16]
    mov     [UP + user_HERE], r8
    next()
endp()

proc(compile_xt_from_rcx)
    mov     [DSP - cell], TOS
    mov     TOS, rcx
    stk(0, 1)
    call    compile_word
    ret
endp()

proc(skip_optional_source_blank)
    mov     r8, [UP + user_TO_IN]
    mov     r9, [UP + user_SOURCE_LEN]
    cmp     r8, r9
    jae     .done
    mov     r10, [UP + user_SOURCE_ADDR]
    movzx   ecx, byte ptr [r10 + r8]
    cmp     ecx, 32
    jne     .done
    inc     qword ptr [UP + user_TO_IN]
.done:
    ret
endp()

proc(push_mark_const)
    mov     [DSP - cell], TOS
    mov     TOS, rcx
    stk(0, 1)
    ret
endp()

proc(emit_unloop_inline)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; add rsp, 16
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC4
    mov     byte ptr [r8 + 3], 0x10
    add     r8, 4
    mov     [UP + user_HERE], r8
    ret
endp()

; unloop  ( -- )  [compile-time/runtime loop-frame drop]
proc(unloop_word)
    jmp     two_rdrop
endp()

; inline-unloop,  ( xt -- )
proc(inline_unloop_comp)
    call    emit_unloop_inline
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

proc(close_loop_common)
    mov     rcx, -3
    call    push_mark_const
    call    qpairs                           ; leaves do-mark address on TOS
    call    back_resolve                     ; patch raw loop branch back to do-bias
 .resolve_leaves:
    cmp     TOS, -5
    jne     .emit_unloop
    mov     TOS, -1                          ; mark-leave -> mark-if for THEN fixup
    call    then_word
    jmp     .resolve_leaves

.emit_unloop:
    lea     rcx, [rip + unloop_word]
    call    compile_xt_from_rcx              ; drop the active loop frame
    cmp     TOS, -4                          ; ?do leaves a second mark pair behind
    jne     .done
    mov     TOS, [DSP]                       ; raise the ?do forward-branch address
    stk(1, 0)
    call    forward_resolve
.done:
    ret
endp()

; do  ( c: -- do-sys )                                      IMMEDIATE
proc(do_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    lea     rcx, [rip + do_part1]
    call    compile_xt_from_rcx
    lea     rcx, [rip + do_part2]
    call    compile_xt_from_rcx
    call    mark_to
    mov     rcx, -3
    call    push_mark_const
    call    pin_begin_maybe
    next()
endp()

; ?do  ( c: -- ?do-sys do-sys )                             IMMEDIATE
proc(qdo_control_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    lea     rcx, [rip + do_part1]
    call    compile_xt_from_rcx
    lea     rcx, [rip + bra_qdo_word]
    call    compile_xt_from_rcx
    call    mark_to
    mov     rcx, -4
    call    push_mark_const
    lea     rcx, [rip + do_part2]
    call    compile_xt_from_rcx
    call    mark_to
    mov     rcx, -3
    call    push_mark_const
    call    pin_begin_maybe
    next()
endp()

; loop  ( -- )  ( c: do-sys -- )                            IMMEDIATE
proc(loop_control_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    lea     rcx, [rip + loop_word]
    call    compile_xt_from_rcx
    call    close_loop_common
    next()
endp()

; +loop  ( n -- )  ( c: do-sys -- )                         IMMEDIATE
proc(plus_loop_control_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    lea     rcx, [rip + plus_loop_word]
    call    compile_xt_from_rcx
    call    close_loop_common
    next()
endp()

; -loop  ( n -- )  ( c: do-sys -- )                         IMMEDIATE
proc(minus_loop_control_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    lea     rcx, [rip + minus_loop_word]
    call    compile_xt_from_rcx
    call    close_loop_common
    next()
endp()

; leave  ( do-sys ... -- orig do-sys ... )                  IMMEDIATE
proc(leave_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    lea     r8, [UP + user_DO_TMP1]          ; scratch: pairs above nearest do-sys
    add     r8, cell
    mov     r9, DSP                          ; scan addr pointer for pair 0
    mov     r10, TOS                         ; scan marker
    xor     r11d, r11d                       ; stripped pair count

.scan:
    cmp     r10, -3                          ; mark-do
    je      .found_do
    mov     [r8], r10                        ; save marker
    mov     rcx, [r9]                        ; save addr
    mov     [r8 + cell], rcx
    add     r8, 2*cell
    inc     r11
    mov     r10, [r9 + cell]                 ; next marker
    add     r9, 2*cell                       ; next addr
    jmp     .scan

.found_do:
    mov     [UP + user_DO_TMP0], r11         ; save stripped pair count across calls
    mov     TOS, r10                         ; expose do marker on top
    mov     DSP, r9                          ; do addr now NOS
    call    ahead_word                       ; -> mark-if/orig above do-sys
    call    two_swap                         ; -> do-sys above leave placeholder
    mov     qword ptr [DSP + cell], -5       ; mark-leave replaces mark-if

    mov     r11, [UP + user_DO_TMP0]
    test    r11, r11
    jz      .done
    lea     r8, [UP + user_DO_TMP1]
    add     r8, cell
    mov     rcx, r11
    shl     rcx, 4                           ; 2 cells per saved pair
    add     r8, rcx
    sub     r8, 2*cell                       ; deepest stripped pair

.restore:
    mov     rcx, [r8 + cell]                 ; addr
    mov     [DSP - cell], TOS
    mov     TOS, rcx
    stk(0, 1)
    mov     rcx, [r8]                        ; marker
    mov     [DSP - cell], TOS
    mov     TOS, rcx
    stk(0, 1)
    sub     r8, 2*cell
    dec     r11
    jnz     .restore

.done:
    next()
endp()

; ?leave  ( f -- )                                           IMMEDIATE
proc(qleave_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    call    if_word
    call    leave_word
    call    then_word
    next()
endp()

; ?bra  ( n -- )  [compile-only runtime stub]
proc(qbra_word)
    jmp     comp_only_word
endp()

; -?bra  ( n -- n )  [compile-only runtime stub]
proc(minus_qbra_word)
    jmp     comp_only_word
endp()

; bra-?do  ( -- )  [compile-only runtime stub]
proc(bra_qdo_word)
    jmp     comp_only_word
endp()

; _loop  ( -- )  [compile-only runtime stub]
proc(loop_word)
    jmp     comp_only_word
endp()

; _+loop  ( n -- )  [compile-only runtime stub]
proc(plus_loop_word)
    jmp     comp_only_word
endp()

; _-loop  ( n -- )  [compile-only runtime stub]
proc(minus_loop_word)
    jmp     comp_only_word
endp()

; inline-bra,  ( xt -- )
;     Emit `jmp rel32` with a zero displacement placeholder.
proc(inline_bra_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0xE9
    mov     dword ptr [r8 + 1], 0
    add     r8, 5
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline--?bra,  ( xt -- )
;     Emit non-destructive test-and-branch with a zero displacement.
proc(inline_minus_qbra_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; test rax, rax
    mov     byte ptr [r8 + 1], 0x85
    mov     byte ptr [r8 + 2], 0xC0
    mov     byte ptr [r8 + 3], 0x0F          ; jz rel32 0
    mov     byte ptr [r8 + 4], 0x84
    mov     dword ptr [r8 + 5], 0
    add     r8, 9
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-?bra,  ( xt -- )
;     Emit destructive test-and-branch with a zero displacement.
proc(inline_qbra_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; add rbp, 8
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC5
    mov     byte ptr [r8 + 3], 0x08
    mov     byte ptr [r8 + 4], 0x48          ; test rax, rax
    mov     byte ptr [r8 + 5], 0x85
    mov     byte ptr [r8 + 6], 0xC0
    mov     byte ptr [r8 + 7], 0x48          ; mov rax, [rbp - 8]
    mov     byte ptr [r8 + 8], 0x8B
    mov     byte ptr [r8 + 9], 0x45
    mov     byte ptr [r8 + 10], 0xF8
    mov     byte ptr [r8 + 11], 0x0F         ; jz rel32 0
    mov     byte ptr [r8 + 12], 0x84
    mov     dword ptr [r8 + 13], 0
    add     r8, 17
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-bra-?do,  ( xt -- )
;     Emit the loop-entry compare-and-branch with a zero displacement.
proc(inline_bra_qdo_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; cmp rdx, rcx
    mov     byte ptr [r8 + 1], 0x39
    mov     byte ptr [r8 + 2], 0xCA
    mov     byte ptr [r8 + 3], 0x0F          ; jz rel32 0
    mov     byte ptr [r8 + 4], 0x84
    mov     dword ptr [r8 + 5], 0
    add     r8, 9
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-_loop,  ( xt -- )
;     Emit WF32's loop-step body with a zero displacement placeholder.
proc(inline_loop_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; add qword ptr [rsp], 1
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0x04
    mov     byte ptr [r8 + 3], 0x24
    mov     byte ptr [r8 + 4], 0x01
    mov     byte ptr [r8 + 5], 0x0F          ; jno rel32 0
    mov     byte ptr [r8 + 6], 0x81
    mov     dword ptr [r8 + 7], 0
    add     r8, 11
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-_+loop,  ( xt -- )
;     Emit WF32's +LOOP step body with a zero displacement placeholder.
proc(inline_plus_loop_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; add rbp, 8
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC5
    mov     byte ptr [r8 + 3], 0x08
    mov     byte ptr [r8 + 4], 0x48          ; add [rsp], rax
    mov     byte ptr [r8 + 5], 0x01
    mov     byte ptr [r8 + 6], 0x04
    mov     byte ptr [r8 + 7], 0x24
    mov     byte ptr [r8 + 8], 0x48          ; mov rax, [rbp - 8]
    mov     byte ptr [r8 + 9], 0x8B
    mov     byte ptr [r8 + 10], 0x45
    mov     byte ptr [r8 + 11], 0xF8
    mov     byte ptr [r8 + 12], 0x0F         ; jno rel32 0
    mov     byte ptr [r8 + 13], 0x81
    mov     dword ptr [r8 + 14], 0
    add     r8, 18
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-_-loop,  ( xt -- )
;     Emit WF32's -LOOP step body with a zero displacement placeholder.
proc(inline_minus_loop_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; add rbp, 8
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC5
    mov     byte ptr [r8 + 3], 0x08
    mov     byte ptr [r8 + 4], 0x48          ; sub [rsp], rax
    mov     byte ptr [r8 + 5], 0x29
    mov     byte ptr [r8 + 6], 0x04
    mov     byte ptr [r8 + 7], 0x24
    mov     byte ptr [r8 + 8], 0x48          ; mov rax, [rbp - 8]
    mov     byte ptr [r8 + 9], 0x8B
    mov     byte ptr [r8 + 10], 0x45
    mov     byte ptr [r8 + 11], 0xF8
    mov     byte ptr [r8 + 12], 0x0F         ; jno rel32 0
    mov     byte ptr [r8 + 13], 0x81
    mov     dword ptr [r8 + 14], 0
    add     r8, 18
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; literal  ( n -- )                    [compile-time only, not in dict]
;     Emit an inline push of n at HERE — no CALL, no inline data quad.
;     The push is `mov [rbp-8],rax ; <load rax,n> ; sub rbp,8`, with the
;     load picked by value so the common cases stay 13 B or smaller and
;     none pays do_lit's guaranteed return mispredict:
;
;        n == 0                  xor eax,eax            (4+2+4 = 10 B)
;        0 < n <= 0xFFFFFFFF     mov eax,imm32          (4+5+4 = 13 B)
;        -2^31 <= n < 0          mov rax,imm32 (sext)   (4+7+4 = 15 B)
;        else                    movabs rax,imm64       (4+10+4 = 18 B)
;
;     Stamps the LIT watermark (LAST_LIT_END/_VAL/_START) so a following
;     foldable operator can rewind over this push via try_fold_literal.
proc(literal)
    mov     rdx, TOS                         ; rdx = n (value to bake in)
    mov     r8, [UP + user_HERE]
    mov     [UP + user_LAST_LIT_START], r8   ; fold rewind target = push start
    ; spill old TOS to NOS:  mov [rbp-8], rax   (48 89 45 F8)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0xF8
    add     r8, 4
    ; --- load n into rax with the smallest encoding ---
    test    rdx, rdx
    jz      .zero
    mov     rcx, rdx
    shr     rcx, 32
    jz      .u32                             ; high 32 == 0  → mov eax, imm32
    movsxd  rcx, edx
    cmp     rcx, rdx
    je      .s32                             ; sign-extends   → mov rax, imm32
    ; movabs rax, imm64   (48 B8 + 8 bytes)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0xB8
    mov     [r8 + 2], rdx
    add     r8, 10
    jmp     .bump
.zero:
    mov     byte ptr [r8 + 0], 0x31          ; xor eax, eax
    mov     byte ptr [r8 + 1], 0xC0
    add     r8, 2
    jmp     .bump
.u32:
    mov     byte ptr [r8 + 0], 0xB8          ; mov eax, imm32 (zero-extends rax)
    mov     dword ptr [r8 + 1], edx
    add     r8, 5
    jmp     .bump
.s32:
    mov     byte ptr [r8 + 0], 0x48          ; mov rax, imm32 (sign-extended)
    mov     byte ptr [r8 + 1], 0xC7
    mov     byte ptr [r8 + 2], 0xC0
    mov     dword ptr [r8 + 3], edx
    add     r8, 7
.bump:
    mov     byte ptr [r8 + 0], 0x48          ; sub rbp, 8  (commit the push)
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xED
    mov     byte ptr [r8 + 3], 0x08
    add     r8, 4
    mov     [UP + user_HERE], r8
    mov     [UP + user_LAST_LIT_END], r8     ; watermark: literal ends here
    mov     [UP + user_LAST_LIT_VAL], rdx    ; ...and carried its value
    ; Drop n (compile-time stack housekeeping, mirrors the old literal).
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; ── Register-pinning Phase 0: record / replay substrate ───────────────
; A do...loop body compiled in compile state is recorded (not emitted) as
; (action, payload) records, then replayed verbatim through the normal
; compile dispatch when the matching `loop` closes. Phase 0 does NO pinning;
; replay is an identity transform. See docs/design/register_pinning_v1.md.

; pin_begin_maybe  ( -- )
;     Called at the tail of `do`/`?do` in compile state. Starts recording
;     iff we are not already recording, not replaying, and the current colon
;     def has no active locals (locals-in-loop is unsupported in Phase 0).
proc(pin_begin_maybe)
    cmp     qword ptr [UP + user_PIN_RECORDING], 0
    jne     .no
    cmp     qword ptr [UP + user_PIN_REPLAYING], 0
    jne     .no
    cmp     qword ptr [UP + user_LOCALS_COUNT], 0
    jne     .no
    ; WF66 capture owns loop bodies while recording — the pin recorder's path
    ; bypasses the WF66 convergence hooks, so don't arm it here.
    cmp     qword ptr [UP + user_WF66_REC], 0
    jne     .no
    mov     qword ptr [UP + user_PIN_RECORDING], 1
    mov     qword ptr [UP + user_PIN_NEST], 1
    mov     qword ptr [UP + user_PIN_BUF_LEN], 0
.no:
    next()
endp()

; pin_append  ( -- )   CF=0 appended, CF=1 buffer overflow (not appended)
;     Append a record built from user_PIN_SAVE_CT (action) and
;     user_PIN_SAVE_XT (payload). Does not touch TOS/DSP. Scratch: r8,r9,r10.
proc(pin_append)
    mov     r8, [UP + user_PIN_BUF_LEN]
    cmp     r8, pin_buf_cap
    jae     .overflow
    mov     r9, r8
    shl     r9, 4                            ; *16 (2 cells / record)
    lea     r10, [UP + user_PIN_BUF]
    add     r9, r10
    mov     r10, [UP + user_PIN_SAVE_CT]
    mov     [r9], r10                        ; action
    mov     r10, [UP + user_PIN_SAVE_XT]
    mov     [r9 + cell], r10                 ; payload
    inc     r8
    mov     [UP + user_PIN_BUF_LEN], r8
    clc
    ret
.overflow:
    stc
    ret
endp()

; pin_replay  ( -- )
;     Clear recording, set replaying, then re-dispatch every buffered record
;     through the normal compile sequence:
;         mov [DSP-cell],TOS ; mov TOS,payload ; sub DSP,cell ; call action
;     For a word, action=ct and payload=xt; for a literal, action=`literal`
;     and payload=value; for an immediate, action=`execute` and payload=xt.
;     Net data-stack effect per record is zero, so control-flow marks ride
;     through untouched. Clears the buffer on exit.
proc(pin_replay)
    mov     qword ptr [UP + user_PIN_RECORDING], 0
    mov     qword ptr [UP + user_PIN_REPLAYING], 1
    mov     qword ptr [UP + user_PIN_REPLAY_IDX], 0
.loop:
    mov     r8, [UP + user_PIN_REPLAY_IDX]
    cmp     r8, [UP + user_PIN_BUF_LEN]
    jae     .done
    mov     r9, r8
    shl     r9, 4
    lea     r10, [UP + user_PIN_BUF]
    add     r9, r10
    mov     rcx, [r9]                        ; action
    mov     rdx, [r9 + cell]                 ; payload
    inc     r8                               ; advance cursor in memory before the
    mov     [UP + user_PIN_REPLAY_IDX], r8   ; call (which clobbers everything)
    cmp     rcx, pin_rec_skip
    je      .loop                            ; folded into a prior pinned access
    cmp     rcx, pin_rec_access
    je      .access
    cmp     rcx, pin_rec_flit
    je      .flit
    mov     [DSP - cell], TOS
    mov     TOS, rdx
    sub     DSP, cell
    call    rcx
    jmp     .loop
.flit:
    ; rdx = float bits: re-push onto the compile-time FP stack (FTOS convention),
    ; then fliteral consumes it and emits `call do_flit ; .quad bits`. No
    ; data-stack effect.
    mov     r8, [UP + user_FSP]
    movsd   qword ptr [r8 - cell], xmm15     ; spill old FTOS
    sub     r8, cell
    mov     [UP + user_FSP], r8
    movq    xmm15, rdx                       ; FTOS := bits
    call    fliteral
    jmp     .loop
.access:
    ; rdx = kind<<8 | reg. Emit the pinned access at HERE (no data-stack effect
    ; at compile time). Preserve TOS across the C call.
    push    rax
    mov     rcx, UP
    win64_call(rt_pin_emit_access)
    pop     rax
    jmp     .loop
.done:
    mov     qword ptr [UP + user_PIN_REPLAYING], 0
    mov     qword ptr [UP + user_PIN_BUF_LEN], 0
    ret
endp()

; fliteral  ( F: r -- )               [compile-time only, not in dict]
;     Compile the sequence  call do_flit ; .quad bits   at HERE.
proc(fliteral)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8], 0xE8
    lea     r9, [rip + do_flit]
    sub     r9, r8
    sub     r9, 5
    mov     dword ptr [r8 + 1], r9d
    movq    r10, xmm15                       ; bits to embed = FTOS
    mov     [r8 + 5], r10
    mov     rcx, [UP + user_FSP]             ; pop FP stack
    movsd   xmm15, qword ptr [rcx]
    add     rcx, cell
    mov     [UP + user_FSP], rcx
    add     r8, 13
    mov     [UP + user_HERE], r8
    next()
endp()

; sliteral  ( c-addr u -- )            [compile-time only, not in dict]
;     Compile call do_slit ; .quad len ; <len bytes> at HERE.
proc(sliteral)
    mov     rsi, [DSP]                       ; source addr
    mov     rcx, TOS                         ; len
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8], 0xE8
    lea     r9, [rip + do_slit]
    sub     r9, r8
    sub     r9, 5
    mov     dword ptr [r8 + 1], r9d
    mov     [r8 + 5], rcx
    lea     rdi, [r8 + 13]
    xor     r10, r10
.copy_loop:
    cmp     r10, rcx
    jae     .copied
    mov     al, byte ptr [rsi + r10]
    mov     byte ptr [rdi + r10], al
    inc     r10
    jmp     .copy_loop

.copied:
    add     rdi, rcx
    mov     [UP + user_HERE], rdi
    mov     TOS, [DSP + cell]
    add     DSP, 2*cell
    next()
endp()

; cliteral  ( c-addr -- )              [compile-time only, not in dict]
;     Compile call do_clit ; .byte len ; <len bytes> at HERE.
proc(cliteral)
    mov     rsi, TOS                         ; counted-string addr
    movzx   rcx, byte ptr [rsi]              ; len (truncated to 255 by WORD)
    lea     rsi, [rsi + 1]                   ; source bytes
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8], 0xE8
    lea     r9, [rip + do_clit]
    sub     r9, r8
    sub     r9, 5
    mov     dword ptr [r8 + 1], r9d
    mov     byte ptr [r8 + 5], cl
    lea     rdi, [r8 + 6]
    xor     r10, r10
.copy_loop:
    cmp     r10, rcx
    jae     .copied
    mov     al, byte ptr [rsi + r10]
    mov     byte ptr [rdi + r10], al
    inc     r10
    jmp     .copy_loop

.copied:
    add     rdi, rcx
    mov     [UP + user_HERE], rdi
    mov     TOS, [DSP]
    add     DSP, cell
    next()
endp()

; :  ( -- )
;     Parse the next whitespace-delimited token, allocate a dict header
;     at HERE with that name (via `(create)`), then set STATE=1. The
;     new word is visible to `find_name` during its own compilation —
;     so a definition can refer to itself (recursive by default,
;     matching most modern Forths).
proc(colon)
    ; State-mismatch guard: if we're already in compile mode, the
    ; user (or a misbehaving immediate word) is starting a new
    ; definition without closing the current one.  This is almost
    ; always a forgotten `;` or `]` and the right thing is to
    ; throw -29 (compiler nesting) immediately rather than let
    ; the broken definition silently corrupt state and produce
    ; a flood of `?` markers in subsequent token lookups.
    cmp     qword ptr [UP + user_STATE], 0
    je      .ok_to_compile
    call    throw_compnest_const
    call    throw_word
    next()

.ok_to_compile:
    call    parse_name                       ; ( -- c-addr u )
    test    TOS, TOS
    jnz     .got_name

    ; No name on this line. Drop (c-addr 0), restore the incoming TOS,
    ; then THROW -16 (`throw_namereqd`).
    mov     TOS, [DSP + cell]
    add     DSP, 2*cell
    call    throw_namereqd_const
    call    throw_word
    next()

.got_name:
    ; (create) consumes ( c-addr u ), builds the header, sets
    ; LATEST → new header, HERE → body start.
    call    create
    mov     r8, [UP + user_LATEST]
    mov     byte ptr [r8 + dh_tfa], tfa_tcol
    ; Enter compile mode. Clear any stale locals state and tail-call
    ; tracking in case a prior compile aborted mid-definition.
    mov     qword ptr [UP + user_STATE], 1
    mov     qword ptr [UP + user_LOCALS_COUNT], 0
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     qword ptr [UP + user_OPT_FENCE], 0
    mov     qword ptr [UP + user_LAST_LIT_END], 0
    mov     qword ptr [UP + user_LAST_DUP_END], 0
    mov     qword ptr [UP + user_LAST_CMP_END], 0
    mov     qword ptr [UP + user_LAST_ADDR_END], 0
    ; WF66 token-IR capture: if enabled, begin shadow-recording this definition.
    ; The eager compiler still runs; `;` rewrites the body iff it was deferrable.
    cmp     qword ptr [UP + user_WF66_ENABLE], 0
    je      .no_wf66_begin
    mov     qword ptr [UP + user_WF66_REC], 1
    push    rax
    mov     rcx, UP
    win64_call(rt_ir_begin)
    pop     rax
.no_wf66_begin:
    next()
endp()

; ;  ( -- )                                          IMMEDIATE
;     Finish the current definition: emit a single RET into the body
;     and leave compile mode. The header was already linked into the
;     chain by `(create)` when `:` ran, so no commit step is needed.
; Emit `add r15, count*8` machine code at HERE if user_LOCALS_COUNT > 0.
; Encoding:   49 81 C7  imm32_le   = add r15, imm32  (7 bytes)
; Used by both ; and EXIT so colon defs with locals release the frame
; on every exit path. Idempotent across multiple EXIT sites — the count
; isn't zeroed here (only ; clears it after the final RET).
proc(emit_locals_release)
    mov     rcx, [UP + user_LOCALS_COUNT]
    test    rcx, rcx
    jz      .none
    shl     rcx, 3                              ; bytes = count*8
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x49
    mov     byte ptr [r8 + 1], 0x81
    mov     byte ptr [r8 + 2], 0xC7
    mov     dword ptr [r8 + 3], ecx             ; imm32 little-endian
    add     r8, 7
    mov     [UP + user_HERE], r8
.none:
    ret
endp()

proc(semicolon)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile

    call    comp_only_word
    next()

.in_compile:
    ; WF66 token-IR finalize: if we were capturing, let the finalizer try to
    ; rewrite the body. Returns 1 (it rewrote the body, including the ret) or 0
    ; (non-deferrable -> keep the eagerly-compiled body and finish normally).
    cmp     qword ptr [UP + user_WF66_REC], 0
    je      .normal_finish
    push    rax
    mov     rcx, UP
    win64_call(rt_ir_finalize)
    mov     r11, rax
    pop     rax
    test    r11, r11
    jz      .normal_finish
    ; Body already complete (push…/ret) at HERE; just leave compile state.
    mov     qword ptr [UP + user_STATE], 0
    mov     qword ptr [UP + user_LOCALS_COUNT], 0
    mov     qword ptr [UP + user_TAIL_CALL], 0
    next()
.normal_finish:
    call    emit_locals_release
    mov     r8, [UP + user_HERE]
    ; Tail-call optimisation: if the most recent CALL is immediately
    ; before the RET we're about to emit, patch its 0xE8 opcode to
    ; 0xE9 (JMP).  The rel32 byte layout is identical, so the callee
    ; still receives control at the same offset -- but no return
    ; address is pushed, and its own RET pops our caller's return
    ; address directly.  emit_locals_release advances HERE past the
    ; tail-call slot when a locals frame is present, so this only
    ; fires for leaf-frame words.
    cmp     r8, [UP + user_TAIL_CALL]
    jne     .no_tco
    mov     byte ptr [r8 - 5], 0xE9
.no_tco:
    mov     byte ptr [r8], 0xC3              ; RET
    inc     r8
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_STATE], 0
    mov     qword ptr [UP + user_LOCALS_COUNT], 0
    mov     qword ptr [UP + user_TAIL_CALL], 0      ; clear for next definition
    next()
endp()

; exit  ( -- )                                        IMMEDIATE
;     Compile an early return from the current definition. If the
;     definition has a locals frame, release it first.  Same tail-call
;     optimisation as ; (patches a preceding CALL into a JMP when the
;     RET is the only thing emitted after it).
proc(exit_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile

    call    comp_only_word
    next()

.in_compile:
    call    emit_locals_release
    mov     r8, [UP + user_HERE]
    cmp     r8, [UP + user_TAIL_CALL]
    jne     .no_tco
    mov     byte ptr [r8 - 5], 0xE9
.no_tco:
    mov     byte ptr [r8], 0xC3
    inc     r8
    mov     [UP + user_HERE], r8
    next()
endp()

; create  ( -- )
;     Parse the next name, build a CREATE-family header, then emit a
;     tiny per-word stub at xt that pushes the word's body address.
;     The body begins immediately after the aligned stub.
proc(create_word)
    call    parse_name                       ; ( -- c-addr u )
    test    TOS, TOS
    jnz     .got_name

    ; No name on this line. Drop (c-addr 0), restore the incoming TOS,
    ; then THROW -16 (`throw_namereqd`).
    mov     TOS, [DSP + cell]
    add     DSP, 2*cell
    call    throw_namereqd_const
    call    throw_word
    next()

.got_name:
    call    create                           ; internal header builder
    mov     r8, [UP + user_LATEST]
    mov     byte ptr [r8 + dh_tfa], tfa_tcre

    mov     r9, [UP + user_HERE]             ; xt (stub location, code region)
    mov     r10, [UP + user_VAR_HERE]        ; body address (RW data region)

    ; mov [rbp-8], rax
    mov     byte ptr [r9 + 0], 0x48
    mov     byte ptr [r9 + 1], 0x89
    mov     byte ptr [r9 + 2], 0x45
    mov     byte ptr [r9 + 3], 0xF8
    ; mov rax, imm64
    mov     byte ptr [r9 + 4], 0x48
    mov     byte ptr [r9 + 5], 0xB8
    mov     qword ptr [r9 + 6], r10
    ; sub rbp, 8
    mov     byte ptr [r9 + 14], 0x48
    mov     byte ptr [r9 + 15], 0x83
    mov     byte ptr [r9 + 16], 0xED
    mov     byte ptr [r9 + 17], 0x08
    ; ret
    mov     byte ptr [r9 + 18], 0xC3
    ; Clear the stub padding bytes (code region; never executed past the ret).
    mov     dword ptr [r9 + 19], 0
    mov     byte ptr [r9 + 23], 0

    ; Code-here advances past the stub only; the body lives in the data region
    ; (user_VAR_HERE), grown by the following , / allot.
    lea     r11, [r9 + create_stub_size]
    mov     [UP + user_HERE], r11
    mov     [UP + user_LATESTXT], r9
    next()
endp()

; :noname  ( -- xt )
;     Start an anonymous colon definition. Pushes the current HERE as the
;     xt onto the data stack, records it in LATESTXT (so RECURSE works),
;     and enters compile mode. Does NOT create a dictionary header.
proc(noname_word)
    mov     r8, [UP + user_HERE]            ; xt = current code address
    mov     [UP + user_LATESTXT], r8        ; RECURSE targets this xt
    mov     [DSP - cell], TOS               ; spill old TOS
    mov     TOS, r8                         ; new TOS = xt
    stk(0, 1)
    mov     qword ptr [UP + user_STATE], 1  ; enter compile mode
    mov     qword ptr [UP + user_OPT_FENCE], 0
    mov     qword ptr [UP + user_LAST_LIT_END], 0
    mov     qword ptr [UP + user_LAST_DUP_END], 0
    mov     qword ptr [UP + user_LAST_CMP_END], 0
    mov     qword ptr [UP + user_LAST_ADDR_END], 0
    next()
endp()

; CODE:  ( "name" ASM-TEXT ";CODE" -- )
;     Defines a new word `name` whose body is raw machine code,
;     written in JASM-flavour MASM between CODE: and ;CODE.
;
;     User asm can use `proc/endp/next/pushd/popd/stk(in,out)` and the
;     standard register conventions (TOS=rax, DSP=rbp, UP=rbx) -- the
;     same vocabulary the kernel itself uses.  A trailing `next()` is
;     auto-appended so the user only has to write the meaningful bytes.
;
;     The body compiles in a fresh JIT module via rt_code_compile_body,
;     which returns the function's address (0 on error).  We then build
;     a standard dict header for `name` and emit a 12-byte
;     `mov rax, fn_addr ; jmp rax` trampoline at HERE.  When `name` is
;     invoked the trampoline does a tail-jump into the compiled code;
;     the function's own `ret` returns directly to the caller, so the
;     trampoline costs only two extra instructions per call site.
;
;     Interpret-only (like `:`); error throws -2057.
proc(code_colon_word)
    call    parse_name                       ; ( -- c-addr u )
    test    TOS, TOS
    jnz     .got_name
    mov     TOS, [DSP + cell]
    add     DSP, 2*cell
    call    throw_namereqd_const
    call    throw_word
    next()

.got_name:
    ; ( c-addr u ) on stack.  Compile body FIRST (so a syntax error in
    ; the asm doesn't leave a half-baked header in the dictionary).
    ; Spill u to PAD; the data stack survives the win64_call (DSP=rbp
    ; is callee-saved) but TOS=rax is the return-value register.
    mov     [UP + user_PAD], TOS

    mov     rcx, UP
    win64_call(rt_code_compile_body)
    test    rax, rax
    jz      .compile_error
    mov     [UP + user_PAD + 8], rax         ; stash fn_addr

    mov     TOS, [UP + user_PAD]             ; restore u
    call    create                           ; consumes (c-addr u); HERE = body

    mov     r8, [UP + user_LATEST]
    mov     byte ptr [r8 + dh_tfa], tfa_tcol

    ; The body is real near-arena code: rt_code_compile_body assembled it
    ; into our near code arena and left fn_addr in user_PAD+8.  Point the
    ; word's xt straight at it — a plain `call rel32` reaches it, so there
    ; is no body, no copy, and no far-segment trampoline.  Then write the
    ; xt back-offset into the arena's reserved header cell at
    ; [fn_addr - cell], exactly like a boot-time primitive, so >ct / >name
    ; recover the header from the xt.
    mov     r10, [UP + user_PAD + 8]         ; r10 = fn_addr (near)
    mov     [r8 + dh_xtptr], r10             ; dh_xtptr = fn_addr
    mov     [UP + user_LATESTXT], r10        ; latestxt = fn_addr
    lea     r9, [r8 + dh_ct]                 ; &dh_ct
    sub     r9, r10                          ; back-offset = &dh_ct - fn_addr
    mov     [r10 - cell], r9                 ; store at [fn_addr - cell]
    next()

.compile_error:
    ; Drop (c-addr u); restore caller's TOS that they had when CODE: ran.
    mov     TOS, [DSP + cell]
    add     DSP, 2*cell
    mov     [DSP - cell], TOS
    mov     TOS, -2057
    stk(0, 1)
    call    throw_word
    next()
endp()

; LET  (immediate)
;     The whole LET form lives in user-source between current TO_IN and
;     the closing `END` token.  We hand it off to the Rust runtime
;     `rt_let_compile`, which parses, lowers via let_lang::compile, JITs
;     into a fresh module, and emits a Win64 trampoline at HERE that
;     loads the inputs from the Forth FP stack, calls the compiled
;     function, and adjusts FSP.
;
;     Compile-only.  On any compile error rt_let_compile prints to
;     stderr and returns u64::MAX; we surface that as THROW -2056.
proc(let_word)
    cmp     qword ptr [UP + user_STATE], 0
    jne     .in_compile
    call    comp_only_word
    next()
.in_compile:
    mov     rcx, UP                          ; arg1 = UP
    win64_call(rt_let_compile)
    test    rax, rax
    jz      .ok
    ; LET compile failed; throw a distinct error code.  rt_let_compile
    ; has already printed details to stderr.
    mov     [DSP - cell], TOS
    mov     TOS, -2056
    stk(0, 1)
    call    throw_word
    next()
.ok:
    next()
endp()
