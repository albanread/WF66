; ─────────────────────────────────────────────────────────────────────
; WF64 kernel — colon compiler.
;
; M4 lets users define new words at runtime via `:` … `;`. The compiled
; body is straight subroutine-threaded code in the dict heap:
;
;   - Each Forth word in the body becomes `call rel32` (5 bytes).
;   - Each literal number becomes an inline push (`mov [rbp-8],rax ;
;     <load rax,N> ; sub rbp,8`), 10..18 bytes by value — see `literal`.
;   - `;` writes a single `ret` byte (0xC3).
;
; M3's VirtualAlloc2 placement guarantees every call between the kernel
; (.text) and the dict heap fits in the rel32 form, so we never need
; the 12-byte indirect path.
; ─────────────────────────────────────────────────────────────────────

; ─────────────────────────────────────────────────────────────────────
; REMINDER: RAX is the cached TOS (top of data stack).
; Any instruction that writes RAX (mov, xor, shl, add, lea, mul, div,
; rep movsb's implicit clobbers, etc.) destroys the user's TOS unless
; it has been spilled to [DSP - cell] first. When scratching, prefer
; RCX/RDX/R8-R11. Save the original TOS in another register at the
; function prologue if any later branch needs it back.
; ─────────────────────────────────────────────────────────────────────

; do_lit  ( -- n )   [runtime helper, retained but no longer emitted]
;     Historically `literal` compiled `call do_lit ; .quad N`; integer
;     literals are now pushed inline (see `literal`), so nothing emits a
;     call here.  Kept as documentation of the call-threaded literal form
;     and so opt_metrics' do_lit probe still resolves a symbol; do_flit
;     (floats) still uses the analogous call-threaded shape.
proc(do_lit)
    ; rcx/rdx scratch only (NOT r9/r10/r11): those are the register-pinning
    ; pool and must survive a literal inside a pinned loop body.
    mov     rcx, [rsp]                       ; rcx = addr of inline data
    mov     rdx, [rcx]                       ; rdx = literal value
    add     qword ptr [rsp], 8               ; skip the 8 bytes on return
    mov     [DSP - cell], TOS                ; old TOS → new NOS slot
    mov     TOS, rdx                         ; new TOS = literal
    stk(0, 1)                                ; sub rbp, 8
    next()
endp()

; do_flit  ( -- )   [runtime helper, never user-callable]
;     Compiled by `fliteral` as: call do_flit ; .quad bits
;     and pushes the IEEE-754 double onto the floating-point stack.
proc(do_flit)
    mov     r8, [rsp]                        ; r8/rdx scratch (preserve pin pool)
    mov     rdx, [r8]
    add     qword ptr [rsp], 8
    mov     rcx, [UP + user_FSP]
    movsd   qword ptr [rcx - cell], xmm15    ; spill old FTOS to new FNOS slot
    sub     rcx, cell
    mov     [UP + user_FSP], rcx
    movq    xmm15, rdx                       ; FTOS := literal bits
    next()
endp()

; do_slit  ( -- c-addr u )   [runtime helper, never user-callable]
;     Compiled by `sliteral` as: call do_slit ; .quad len ; <len bytes>
;     and pushes the inline string address and length.
proc(do_slit)
    mov     rcx, [rsp]                      ; rcx/rdx/r8/rsi scratch (preserve pool)
    mov     rdx, [rcx]                      ; rdx = len
    lea     r8, [rcx + 8]                   ; r8 = string addr
    lea     rsi, [r8 + rdx]                 ; rsi = resume ip
    mov     [rsp], rsi
    mov     [DSP - cell], TOS               ; old TOS -> NNOS
    mov     [DSP - 2*cell], r8              ; c-addr -> NOS
    mov     TOS, rdx                        ; len -> TOS
    stk(0, 2)
    next()
endp()

; do_clit  ( -- c-addr )   [runtime helper, never user-callable]
;     Compiled by `cliteral` as: call do_clit ; .byte len ; <len bytes>
;     and pushes the address of the inline counted string.
proc(do_clit)
    mov     rcx, [rsp]                      ; rcx/rdx/r8 scratch (preserve pool)
    movzx   rdx, byte ptr [rcx]             ; rdx = len
    lea     r8, [rcx + rdx + 1]             ; r8 = resume ip
    mov     [rsp], r8
    mov     [DSP - cell], TOS               ; old TOS -> NOS
    mov     TOS, rcx                        ; counted string addr
    stk(0, 1)
    next()
endp()

; compile  ( xt -- )
;     WF32-style compile token for ordinary words: duplicate xt, map the
;     duplicate to its comp-field address, then dispatch that helper while
;     leaving the original xt on the stack for the helper to consume.
proc(compile_word)
    mov     [DSP - cell], TOS                ; duplicate xt
    stk(1, 2)
    call    to_comp                          ; ( xt xt -- xt a-comp )
    jmp     perform                          ; helper sees original xt on TOS
endp()

; xt-call,  ( xt -- )
;     Append a 5-byte `call rel32` pointing at xt to HERE.
;     Because the dict heap is within ±1.75 GB of every primitive
;     (M3's VirtualAlloc2 placement), the rel32 always fits.
proc(compile_comma)
    mov     r8, [UP + user_HERE]             ; r8 = HERE
    mov     byte ptr [r8], 0xE8              ; CALL opcode
    sub     TOS, r8
    sub     TOS, 5                           ; eax = xt - (HERE + 5)
    mov     dword ptr [r8 + 1], eax
    add     r8, 5
    mov     [UP + user_HERE], r8
    mov     [UP + user_TAIL_CALL], r8        ; remember the position right
                                              ; after the CALL for ; / EXIT
                                              ; tail-call optimisation
    ; Drop xt.
    mov     TOS, [DSP]
    stk(1, 0)                                ; add rbp, 8
    next()
endp()

; xt-call,-no-tco  ( xt -- )
;     Identical to compile, except it does NOT mark the emitted CALL as a
;     tail-call candidate.  Used as the dh_comp helper for primitives that
;     pop / juggle the return address themselves (rdrop, 2rdrop, n>r,
;     nr>) — patching those CALLs into JMPs would feed the callee a
;     stale rstack and crash.  Also clears any pending TAIL_CALL set by
;     an earlier compile, so the next ; / EXIT doesn't wrongly tail-call
;     a previously-emitted safe CALL across this unsafe one.
proc(compile_comma_no_tco)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8], 0xE8
    sub     TOS, r8
    sub     TOS, 5
    mov     dword ptr [r8 + 1], eax
    add     r8, 5
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; ── Literal folding ─────────────────────────────────────────────────
; Peephole optimisation for `<literal> <binop>` sequences.  When a
; foldable binary operator (+, -, *, and, or, xor) is compiled and the
; bytes immediately preceding HERE are a `call do_lit ; .quad N`
; literal emission, rewind HERE by 13 and emit an immediate-form
; instruction in place of the literal+CALL pair.  Saves 9..14 bytes
; per fold plus two CALL/RET round trips at runtime.
;
; Detection signature:
;   [HERE-13]     = 0xE8                       (CALL opcode)
;   [HERE-12..-9] = rel32 such that target == do_lit
;   [HERE-8..-1]  = literal value (8 bytes, must fit in signed imm32)
;
; If any check fails, the helper tail-jumps to compile_comma so the
; normal CALL emission still happens.  The fold also clears
; user_TAIL_CALL so the rewritten instruction is never mistaken for a
; tail-call candidate by ; / EXIT.

; (private) try_fold_literal  -- shared fold preamble.
;     Succeeds iff the most recent emission was an inline literal push whose
;     value fits a signed imm32 and whose start is at/above the peephole fence.
;     On success: CF=0, rcx = literal value, r8 = LAST_LIT_START (rewind base).
;     On failure: CF=1.  Caller falls back (dup-fuse / bare op / leaf copy).
;     Validity hinges on the watermark: LAST_LIT_END == HERE means nothing has
;     been emitted since the literal.  Caller-saved usage: rcx, rdx, r8, r9.
;     Does NOT touch TOS (rax).
proc(try_fold_literal)
    mov     r8, [UP + user_HERE]
    cmp     r8, [UP + user_LAST_LIT_END]     ; is the last emission a literal?
    jne     .no
    mov     rcx, [UP + user_LAST_LIT_VAL]    ; literal value (full 64 bits)
    movsxd  rdx, ecx
    cmp     rdx, rcx
    jne     .no                              ; doesn't fit in signed imm32
    mov     r8, [UP + user_LAST_LIT_START]   ; rewind target = start of the push
    cmp     r8, [UP + user_OPT_FENCE]        ; would we cross a resolved label?
    jb      .no                              ; yes — decline the fold
    ; The literal is about to be consumed (folded, or inlined-after by a caller
    ; that declines on range).  Invalidate the watermark so it can't be folded a
    ; second time: a same-length fold (e.g. `= imm32` is 13 B, exactly the 13 B
    ; literal it replaced) would otherwise leave LAST_LIT_END == HERE and let the
    ; NEXT operator re-fold the spent literal.
    mov     qword ptr [UP + user_LAST_LIT_END], 0
    clc
    ret
.no:
    stc
    ret
endp()

; fold-+,  ( xt -- )      ADD rax, imm   (acc form 48 05 imm32 = 6 B,
;                                          imm8 form 48 83 C0 ii = 4 B)
proc(fold_plus_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC0          ; /0 = ADD
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    jmp     .commit
.imm32:
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x05          ; ADD rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    add     r8, 6
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    mov     r8, [UP + user_HERE]
    ; T3 peephole: an inline `dup` immediately before a bare + is `dup +` ==
    ; 2*TOS.  Fuse to `add rax,rax`, eliminating the spill/reload and the paired
    ; rbp adjusts.  The DUP watermark (== HERE) proves the last emission was a
    ; dup; the fence guards the rewind against crossing a resolved label.
    cmp     r8, [UP + user_LAST_DUP_END]
    jne     .plus_plain
    lea     rcx, [r8 - 8]                    ; dup push is 8 B → rewind target
    cmp     rcx, [UP + user_OPT_FENCE]       ; would we cross a resolved label?
    jb      .plus_plain                      ; yes — fall through to bare +
    mov     qword ptr [UP + user_LAST_DUP_END], 0   ; consume the dup watermark
    sub     r8, 8                            ; rewind over the inline dup
    mov     byte ptr [r8 + 0], 0x48          ; add rax, rax
    mov     byte ptr [r8 + 1], 0x01
    mov     byte ptr [r8 + 2], 0xC0
    add     r8, 3
    jmp     .commit
.plus_plain:
    ; bare + (no foldable literal): inline `add rax,[rbp] ; add rbp,8`
    mov     byte ptr [r8 + 0], 0x48          ; add rax, [rbp]
    mov     byte ptr [r8 + 1], 0x03
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0x00
    mov     byte ptr [r8 + 4], 0x48          ; add rbp, 8  (drop NOS)
    mov     byte ptr [r8 + 5], 0x83
    mov     byte ptr [r8 + 6], 0xC5
    mov     byte ptr [r8 + 7], 0x08
    add     r8, 8
    jmp     .commit
endp()

; fold--,  ( xt -- )      SUB rax, imm
proc(fold_minus_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xE8          ; /5 = SUB
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    jmp     .commit
.imm32:
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x2D          ; SUB rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    add     r8, 6
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    ; bare - (no foldable literal): inline `neg rax ; add rax,[rbp] ; add rbp,8`
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; neg rax
    mov     byte ptr [r8 + 1], 0xF7
    mov     byte ptr [r8 + 2], 0xD8
    mov     byte ptr [r8 + 3], 0x48          ; add rax, [rbp]
    mov     byte ptr [r8 + 4], 0x03
    mov     byte ptr [r8 + 5], 0x45
    mov     byte ptr [r8 + 6], 0x00
    mov     byte ptr [r8 + 7], 0x48          ; add rbp, 8  (drop NOS)
    mov     byte ptr [r8 + 8], 0x83
    mov     byte ptr [r8 + 9], 0xC5
    mov     byte ptr [r8 + 10], 0x08
    add     r8, 11
    jmp     .commit
endp()

; fold-*,  ( xt -- )      IMUL rax, rax, imm  (no accumulator special form,
;                                                imm8 = 4 B, imm32 = 7 B)
proc(fold_times_comp)
    call    try_fold_literal
    jc      .no_fold
    ; ── strength reduction: rewrite `* N` for cheap constants ─────────
    ; After the rewind, rax holds the original TOS and DSP is unchanged
    ; (the spent literal push is gone).  Emit the cheapest in-place
    ; rax := rax * N, then .commit.  rcx = N (fits signed imm32),
    ; r8 = rewind base.  imul is ~3 cyc; shl/add/lea are 1.
    test    rcx, rcx
    jz      .mul0                            ; * 0  -> xor eax,eax
    cmp     rcx, 1
    je      .mul1                            ; * 1  -> nothing
    cmp     rcx, -1
    je      .mulneg1                         ; * -1 -> neg rax
    cmp     rcx, 2
    je      .mul2                            ; * 2  -> add rax,rax
    cmp     rcx, 3
    je      .mul3                            ; * 3  -> lea rax,[rax+rax*2]
    cmp     rcx, 5
    je      .mul5                            ; * 5  -> lea rax,[rax+rax*4]
    cmp     rcx, 9
    je      .mul9                            ; * 9  -> lea rax,[rax+rax*8]
    ; power of two (positive only): N & (N-1) == 0  ->  shl rax, log2(N)
    test    rcx, rcx
    jle     .imul_imm                        ; negative -> plain imul
    lea     rdx, [rcx - 1]
    test    rcx, rdx
    jnz     .imul_imm                        ; not a power of two
    bsf     rcx, rcx                         ; rcx = exponent (N >= 4 here)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0xC1
    mov     byte ptr [r8 + 2], 0xE0          ; SHL rax, imm8
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    jmp     .commit
.imul_imm:
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x6B          ; IMUL r64, r/m64, imm8
    mov     byte ptr [r8 + 2], 0xC0          ; ModR/M: rax,rax
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    jmp     .commit
.imm32:
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x69          ; IMUL r64, r/m64, imm32
    mov     byte ptr [r8 + 2], 0xC0
    mov     dword ptr [r8 + 3], ecx
    add     r8, 7
    jmp     .commit
.mul0:
    mov     byte ptr [r8 + 0], 0x31          ; xor eax, eax  (TOS := 0)
    mov     byte ptr [r8 + 1], 0xC0
    add     r8, 2
    jmp     .commit
.mul1:
    ; * 1 is identity: emit nothing; HERE rewinds to r8 (literal removed).
    jmp     .commit
.mulneg1:
    mov     byte ptr [r8 + 0], 0x48          ; neg rax
    mov     byte ptr [r8 + 1], 0xF7
    mov     byte ptr [r8 + 2], 0xD8
    add     r8, 3
    jmp     .commit
.mul2:
    mov     byte ptr [r8 + 0], 0x48          ; add rax, rax
    mov     byte ptr [r8 + 1], 0x01
    mov     byte ptr [r8 + 2], 0xC0
    add     r8, 3
    jmp     .commit
.mul3:
    mov     byte ptr [r8 + 0], 0x48          ; lea rax, [rax + rax*2]
    mov     byte ptr [r8 + 1], 0x8D
    mov     byte ptr [r8 + 2], 0x04
    mov     byte ptr [r8 + 3], 0x40
    add     r8, 4
    jmp     .commit
.mul5:
    mov     byte ptr [r8 + 0], 0x48          ; lea rax, [rax + rax*4]
    mov     byte ptr [r8 + 1], 0x8D
    mov     byte ptr [r8 + 2], 0x04
    mov     byte ptr [r8 + 3], 0x80
    add     r8, 4
    jmp     .commit
.mul9:
    mov     byte ptr [r8 + 0], 0x48          ; lea rax, [rax + rax*8]
    mov     byte ptr [r8 + 1], 0x8D
    mov     byte ptr [r8 + 2], 0x04
    mov     byte ptr [r8 + 3], 0xC0
    add     r8, 4
    jmp     .commit
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    mov     r8, [UP + user_HERE]
    ; T3 peephole: inline `dup` immediately before a bare * is `dup *` ==
    ; TOS*TOS.  Fuse to `imul rax,rax`.  Gated on the DUP watermark + fence,
    ; same as fold_plus_comp.
    cmp     r8, [UP + user_LAST_DUP_END]
    jne     .times_plain
    lea     rcx, [r8 - 8]                    ; dup push is 8 B → rewind target
    cmp     rcx, [UP + user_OPT_FENCE]       ; would we cross a resolved label?
    jb      .times_plain                     ; yes — fall through to bare *
    mov     qword ptr [UP + user_LAST_DUP_END], 0   ; consume the dup watermark
    sub     r8, 8                            ; rewind over the inline dup
    mov     byte ptr [r8 + 0], 0x48          ; imul rax, rax
    mov     byte ptr [r8 + 1], 0x0F
    mov     byte ptr [r8 + 2], 0xAF
    mov     byte ptr [r8 + 3], 0xC0
    add     r8, 4
    jmp     .commit
.times_plain:
    ; bare * (no foldable literal): inline `imul rax,[rbp] ; add rbp,8`
    mov     byte ptr [r8 + 0], 0x48          ; imul rax, [rbp]
    mov     byte ptr [r8 + 1], 0x0F
    mov     byte ptr [r8 + 2], 0xAF
    mov     byte ptr [r8 + 3], 0x45
    mov     byte ptr [r8 + 4], 0x00
    mov     byte ptr [r8 + 5], 0x48          ; add rbp, 8  (drop NOS)
    mov     byte ptr [r8 + 6], 0x83
    mov     byte ptr [r8 + 7], 0xC5
    mov     byte ptr [r8 + 8], 0x08
    add     r8, 9
    jmp     .commit
endp()

; fold-and,  ( xt -- )    AND rax, imm
proc(fold_and_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xE0          ; /4 = AND
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    jmp     .commit
.imm32:
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x25          ; AND rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    add     r8, 6
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

; fold-or,  ( xt -- )     OR  rax, imm
proc(fold_or_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xC8          ; /1 = OR
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    jmp     .commit
.imm32:
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x0D          ; OR rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    add     r8, 6
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

; fold-xor,  ( xt -- )    XOR rax, imm
proc(fold_xor_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xF0          ; /6 = XOR
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    jmp     .commit
.imm32:
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x35          ; XOR rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    add     r8, 6
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

; ── More literal folds: shifts ──────────────────────────────────────
; Shifts only fold when the literal fits in a signed imm8 (the only
; encoding the SHL/SHR/SAR-by-immediate form supports).  Out-of-range
; literals fall back to a normal CALL.
;
;   op       | imm8 form
;   lshift   | 48 C1 E0 ii   SHL rax, imm8
;   rshift   | 48 C1 E8 ii   SHR rax, imm8
;   arshift  | 48 C1 F8 ii   SAR rax, imm8

proc(fold_lshift_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .no_fold                         ; shifts need imm8 fit
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0xC1
    mov     byte ptr [r8 + 2], 0xE0          ; /4 = SHL
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_rshift_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .no_fold
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0xC1
    mov     byte ptr [r8 + 2], 0xE8          ; /5 = SHR
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_arshift_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .no_fold
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0xC1
    mov     byte ptr [r8 + 2], 0xF8          ; /7 = SAR
    mov     byte ptr [r8 + 3], cl
    add     r8, 4
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

; ── More literal folds: equality ────────────────────────────────────
; `n = lit`  → sub rax, lit ; sub rax, 1     ; sbb rax, rax  (11/13 B)
;     CF=1 iff (rax - lit) == 0, i.e. rax == lit.
; `n <> lit` → sub rax, lit ; add rax, -1    ; sbb rax, rax  (11/13 B)
;     CF=1 iff (rax - lit) != 0, i.e. rax != lit.

proc(fold_equal_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    ; imm8 form (11 B)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xE8          ; SUB rax, imm8
    mov     byte ptr [r8 + 3], cl
    mov     byte ptr [r8 + 4], 0x48
    mov     byte ptr [r8 + 5], 0x83
    mov     byte ptr [r8 + 6], 0xE8          ; SUB rax, 1
    mov     byte ptr [r8 + 7], 0x01
    mov     byte ptr [r8 + 8], 0x48
    mov     byte ptr [r8 + 9], 0x19          ; SBB rax, rax
    mov     byte ptr [r8 + 10], 0xC0
    add     r8, 11
    jmp     .commit
.imm32:
    ; imm32 form (13 B)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x2D          ; SUB rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    mov     byte ptr [r8 + 6], 0x48
    mov     byte ptr [r8 + 7], 0x83
    mov     byte ptr [r8 + 8], 0xE8
    mov     byte ptr [r8 + 9], 0x01
    mov     byte ptr [r8 + 10], 0x48
    mov     byte ptr [r8 + 11], 0x19
    mov     byte ptr [r8 + 12], 0xC0
    add     r8, 13
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_not_equal_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    ; imm8 form (11 B)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xE8          ; SUB rax, imm8
    mov     byte ptr [r8 + 3], cl
    mov     byte ptr [r8 + 4], 0x48
    mov     byte ptr [r8 + 5], 0x83
    mov     byte ptr [r8 + 6], 0xC0          ; ADD rax, imm8
    mov     byte ptr [r8 + 7], 0xFF          ;     (-1 as imm8)
    mov     byte ptr [r8 + 8], 0x48
    mov     byte ptr [r8 + 9], 0x19          ; SBB rax, rax
    mov     byte ptr [r8 + 10], 0xC0
    add     r8, 11
    jmp     .commit
.imm32:
    ; imm32 form (13 B)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x2D          ; SUB rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    mov     byte ptr [r8 + 6], 0x48
    mov     byte ptr [r8 + 7], 0x83
    mov     byte ptr [r8 + 8], 0xC0          ; ADD rax, -1
    mov     byte ptr [r8 + 9], 0xFF
    mov     byte ptr [r8 + 10], 0x48
    mov     byte ptr [r8 + 11], 0x19
    mov     byte ptr [r8 + 12], 0xC0
    add     r8, 13
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

; ── More literal folds: unsigned-less (cheap cmp+sbb form) ──────────
; `n u< lit` → cmp rax, lit ; sbb rax, rax           (7/9 B)
;     CF=1 iff rax < lit unsigned.  sbb rax, rax materialises -1/0.
proc(fold_u_less_comp)
    call    try_fold_literal
    jc      .no_fold
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xF8          ; CMP rax, imm8
    mov     byte ptr [r8 + 3], cl
    mov     byte ptr [r8 + 4], 0x48
    mov     byte ptr [r8 + 5], 0x19          ; SBB rax, rax
    mov     byte ptr [r8 + 6], 0xC0
    add     r8, 7
    jmp     .commit
.imm32:
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x3D          ; CMP rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    mov     byte ptr [r8 + 6], 0x48
    mov     byte ptr [r8 + 7], 0x19
    mov     byte ptr [r8 + 8], 0xC0
    add     r8, 9
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

; ── More literal folds: general comparisons (cmp + setCC + movzx + neg) ─
; All seven of these share the same shape; only the setCC opcode byte
; differs.  Pattern:
;   cmp rax, lit       (4 B imm8 / 6 B imm32 accumulator)
;   setCC al           (3 B)
;   movzx eax, al      (3 B)
;   neg rax            (3 B)
; Totals: 13 B (imm8) or 15 B (imm32).
;
; setCC second-opcode byte cheat-sheet:
;   <  setl  0x9C   |   u>  seta  0x97
;   >  setg  0x9F   |   u<= setbe 0x96
;   <= setle 0x9E   |   u>= setae 0x93
;   >= setge 0x9D   |

@macro emit_cmp_setcc(setcc_byte)
    movsx   rdx, cl
    cmp     rdx, rcx
    jne     .imm32
    ; imm8 form (13 B)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x83
    mov     byte ptr [r8 + 2], 0xF8          ; CMP rax, imm8
    mov     byte ptr [r8 + 3], cl
    mov     byte ptr [r8 + 4], 0x0F
    mov     byte ptr [r8 + 5], &setcc_byte   ; setCC al
    mov     byte ptr [r8 + 6], 0xC0
    mov     byte ptr [r8 + 7], 0x0F
    mov     byte ptr [r8 + 8], 0xB6          ; MOVZX eax, al
    mov     byte ptr [r8 + 9], 0xC0
    mov     byte ptr [r8 + 10], 0x48
    mov     byte ptr [r8 + 11], 0xF7
    mov     byte ptr [r8 + 12], 0xD8         ; NEG rax
    add     r8, 13
    mov     [UP + user_LAST_CMP_END], r8     ; CMP watermark for if/until fusion
    lea     rcx, [r8 - 9]                    ; rewind target = just past the cmp
    mov     [UP + user_LAST_CMP_REWIND], rcx
    mov     byte ptr [UP + user_LAST_CMP_SETCC], &setcc_byte
    jmp     .^commit
.imm32:
    ; imm32 form (15 B)
    mov     byte ptr [r8 + 0], 0x48
    mov     byte ptr [r8 + 1], 0x3D          ; CMP rax, imm32 (accumulator)
    mov     dword ptr [r8 + 2], ecx
    mov     byte ptr [r8 + 6], 0x0F
    mov     byte ptr [r8 + 7], &setcc_byte
    mov     byte ptr [r8 + 8], 0xC0
    mov     byte ptr [r8 + 9], 0x0F
    mov     byte ptr [r8 + 10], 0xB6
    mov     byte ptr [r8 + 11], 0xC0
    mov     byte ptr [r8 + 12], 0x48
    mov     byte ptr [r8 + 13], 0xF7
    mov     byte ptr [r8 + 14], 0xD8
    add     r8, 15
    mov     [UP + user_LAST_CMP_END], r8     ; CMP watermark for if/until fusion
    lea     rcx, [r8 - 9]                    ; rewind target = just past the cmp
    mov     [UP + user_LAST_CMP_REWIND], rcx
    mov     byte ptr [UP + user_LAST_CMP_SETCC], &setcc_byte
@endmacro

proc(fold_less_comp)
    call    try_fold_literal
    jc      .no_fold
    emit_cmp_setcc(0x9C)                     ; setl
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_greater_comp)
    call    try_fold_literal
    jc      .no_fold
    emit_cmp_setcc(0x9F)                     ; setg
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_less_equal_comp)
    call    try_fold_literal
    jc      .no_fold
    emit_cmp_setcc(0x9E)                     ; setle
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_greater_equal_comp)
    call    try_fold_literal
    jc      .no_fold
    emit_cmp_setcc(0x9D)                     ; setge
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_u_greater_comp)
    call    try_fold_literal
    jc      .no_fold
    emit_cmp_setcc(0x97)                     ; seta
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_u_less_equal_comp)
    call    try_fold_literal
    jc      .no_fold
    emit_cmp_setcc(0x96)                     ; setbe
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

proc(fold_u_greater_equal_comp)
    call    try_fold_literal
    jc      .no_fold
    emit_cmp_setcc(0x93)                     ; setae
.commit:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.no_fold:
    jmp     inline_leaf_comp
endp()

; (inline,)  ( xt -- )
;     A drop-in alternative for xt-call,/compile, that inlines a leaf
;     word's body rather than emitting a CALL.  Reads the body length
;     from the word's header.dh_ofa (u16, set by `inline` in core.f
;     after `;` measures `HERE - xt - 1`, i.e. excluding the trailing
;     RET).  When dh_ofa is 0, falls back to a plain `compile,`-style
;     CALL emission, so words that haven't been marked inline still
;     work correctly.
;
;     Safe only for LEAF words (no internal CALLs).  Copying a non-
;     leaf body to a new address breaks the rel32 offsets inside it.
;     `inline` (the source-level declarator) doesn't currently verify
;     leafness -- use only on words you know contain no calls.
proc(inline_comma_word)
    mov     r9, TOS                          ; r9 = xt
    mov     rdx, [r9 - cell]                 ; xt-side backoffset (xt → dh_ct)
    add     rdx, r9                          ; = address of dh_ct
    sub     rdx, dh_ct                       ; = header base
    movzx   r8, word ptr [rdx + dh_ofa]     ; length-to-inline

    test    r8, r8
    jz      .fallback_call

    ; Copy r8 bytes from xt (r9) to HERE.
    mov     rsi, r9
    mov     rdi, [UP + user_HERE]
    mov     rcx, r8
    rep     movsb
    mov     [UP + user_HERE], rdi
    mov     TOS, [DSP]
    stk(1, 0)
    next()

.fallback_call:
    mov     r10, [UP + user_HERE]
    mov     byte ptr [r10], 0xE8
    sub     TOS, r10
    sub     TOS, 5
    mov     dword ptr [r10 + 1], eax
    add     r10, 5
    mov     [UP + user_HERE], r10
    mov     [UP + user_TAIL_CALL], r10
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-dup,  ( xt -- )
;     First real WF32-style inline compile helper: ignore xt and emit the
;     body of DUP directly into the current definition, with no CALL/RET
;     boundary.
proc(inline_dup_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov [rbp-8], rax
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0xF8
    mov     byte ptr [r8 + 4], 0x48          ; sub rbp, 8
    mov     byte ptr [r8 + 5], 0x83
    mov     byte ptr [r8 + 6], 0xED
    mov     byte ptr [r8 + 7], 0x08
    add     r8, 8
    mov     [UP + user_HERE], r8
    mov     [UP + user_LAST_DUP_END], r8     ; T3 dup-fuse watermark
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-drop,  ( xt -- )
;     Emit DROP directly into the current definition.
proc(inline_drop_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov rax, [rbp]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0x00
    mov     byte ptr [r8 + 4], 0x48          ; add rbp, 8
    mov     byte ptr [r8 + 5], 0x83
    mov     byte ptr [r8 + 6], 0xC5
    mov     byte ptr [r8 + 7], 0x08
    add     r8, 8
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-swap,  ( xt -- )
;     Emit SWAP directly into the current definition.
proc(inline_swap_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov rcx, [rbp]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x4D
    mov     byte ptr [r8 + 3], 0x00
    mov     byte ptr [r8 + 4], 0x48          ; mov [rbp], rax
    mov     byte ptr [r8 + 5], 0x89
    mov     byte ptr [r8 + 6], 0x45
    mov     byte ptr [r8 + 7], 0x00
    mov     byte ptr [r8 + 8], 0x48          ; mov rax, rcx
    mov     byte ptr [r8 + 9], 0x89
    mov     byte ptr [r8 + 10], 0xC8
    add     r8, 11
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-over,  ( xt -- )
;     Emit OVER directly into the current definition.
proc(inline_over_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov [rbp-8], rax
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0xF8
    mov     byte ptr [r8 + 4], 0x48          ; mov rax, [rbp]
    mov     byte ptr [r8 + 5], 0x8B
    mov     byte ptr [r8 + 6], 0x45
    mov     byte ptr [r8 + 7], 0x00
    mov     byte ptr [r8 + 8], 0x48          ; sub rbp, 8
    mov     byte ptr [r8 + 9], 0x83
    mov     byte ptr [r8 + 10], 0xED
    mov     byte ptr [r8 + 11], 0x08
    add     r8, 12
    mov     [UP + user_HERE], r8
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-@,  ( xt -- )
;     Emit bare @ (fetch) inline: `mov rax, [rax]`.  No fold form (an address
;     literal `addr @` is rare and not worth a special case); a bare @ used to
;     compile to a 5-byte CALL.
proc(inline_fetch_comp)
    mov     r8, [UP + user_HERE]
    ; Fusion: if the previous emission was an inlined variable address push
    ; (lea form), turn its `lea rax,[rip+d]` (48 8D 05) into `mov rax,[rip+d]`
    ; (48 8B 05) — load the value in place — and drop this separate `mov rax,[rax]`.
    cmp     r8, [UP + user_LAST_ADDR_END]
    jne     .normal
    mov     rcx, [UP + user_LAST_ADDR_START]
    cmp     rcx, [UP + user_OPT_FENCE]
    jb      .normal
    mov     byte ptr [r8 - 6], 0x8B          ; lea (8D) → mov r,m (8B); same ModRM/disp
    mov     qword ptr [UP + user_LAST_ADDR_END], 0   ; consume the address push
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.normal:
    mov     byte ptr [r8 + 0], 0x48          ; mov rax, [rax]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x00
    add     r8, 3
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-!,  ( xt -- )
;     Emit bare ! (store) inline, mirroring proc(store):
;       mov rcx, [rbp]      ; value = NOS
;       mov [rax], rcx      ; *addr = value
;       mov rax, [rbp+8]    ; raise NNOS to TOS
;       add rbp, 16         ; drop two cells
proc(inline_store_comp)
    mov     r8, [UP + user_HERE]
    ; Fusion: if the previous emission was an inlined variable address push,
    ; rewind it and store TOS straight into the variable via a RIP-relative
    ; `mov [rip+d], rax`, then drop — no address materialization, no `mov [rax]`.
    cmp     r8, [UP + user_LAST_ADDR_END]
    jne     .normal
    mov     rcx, [UP + user_LAST_ADDR_START] ; rcx = push start (rewind target)
    cmp     rcx, [UP + user_OPT_FENCE]
    jb      .normal
    mov     rdx, [UP + user_LAST_ADDR_BODY]
    lea     r9, [rcx + 7]                    ; next_ip after a 7-byte mov [rip+d],rax
    sub     rdx, r9                          ; disp = body - next_ip
    movsxd  r9, edx
    cmp     r9, rdx                          ; fits signed imm32?
    jne     .normal                          ; no — leave the push + normal store
    mov     r8, rcx                          ; commit: rewind to push start
    mov     byte ptr [r8 + 0], 0x48          ; mov [rip+disp32], rax  (*var = value)
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0x05
    mov     dword ptr [r8 + 3], edx
    mov     byte ptr [r8 + 7], 0x48          ; mov rax, [rbp]  (raise NOS, drop value)
    mov     byte ptr [r8 + 8], 0x8B
    mov     byte ptr [r8 + 9], 0x45
    mov     byte ptr [r8 + 10], 0x00
    mov     byte ptr [r8 + 11], 0x48         ; add rbp, 8
    mov     byte ptr [r8 + 12], 0x83
    mov     byte ptr [r8 + 13], 0xC5
    mov     byte ptr [r8 + 14], 0x08
    add     r8, 15
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     qword ptr [UP + user_LAST_ADDR_END], 0   ; consume the address push
    mov     TOS, [DSP]
    stk(1, 0)
    next()
.normal:
    mov     byte ptr [r8 + 0], 0x48          ; mov rcx, [rbp]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x4D
    mov     byte ptr [r8 + 3], 0x00
    mov     byte ptr [r8 + 4], 0x48          ; mov [rax], rcx
    mov     byte ptr [r8 + 5], 0x89
    mov     byte ptr [r8 + 6], 0x08
    mov     byte ptr [r8 + 7], 0x48          ; mov rax, [rbp+8]
    mov     byte ptr [r8 + 8], 0x8B
    mov     byte ptr [r8 + 9], 0x45
    mov     byte ptr [r8 + 10], 0x08
    mov     byte ptr [r8 + 11], 0x48         ; add rbp, 16
    mov     byte ptr [r8 + 12], 0x83
    mov     byte ptr [r8 + 13], 0xC5
    mov     byte ptr [r8 + 14], 0x10
    add     r8, 15
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-leaf,  ( xt -- )
;     Generic bare-op inliner used by the no-fold path of the logic / comparison
;     / shift fold helpers.  Copies the leaf primitive body at xt — straight-line
;     ALU/compare code, position-independent, no internal branch — up to but not
;     including its terminating ret (0xC3), directly into the definition.  Every
;     redirected primitive is short and contains no 0xC3 byte before its ret.
proc(inline_leaf_comp)
    mov     r8, [UP + user_HERE]             ; dest = HERE
    mov     r9, rax                          ; src  = xt (primitive body start)
.copy:
    movzx   rcx, byte ptr [r9]
    cmp     cl, 0xC3                         ; ret? stop (do not copy it)
    je      .done
    mov     [r8], cl
    inc     r9
    inc     r8
    jmp     .copy
.done:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; (inline-var,)  ( xt -- )
;     Compile helper installed (via hotvariable) on a hot variable so that a
;     reference to it compiles to an INLINE push of its body address instead of
;     a CALL into the create stub.  body = the data-region address baked into the
;     stub's `mov rax, imm64` at xt+6 (same as proc(to_body)).  Emits:
;         mov [rbp-8], rax              ; spill TOS
;         sub rbp, 8                    ; bump DSP
;         lea rax, [rip + disp32]       ; new TOS = body address  (7 B, 15 total)
;     When the data region sits within rel32 (±2 GB) of the code region — the
;     normal case, since alloc_var_region anchors it near region_base — the body
;     is reached with a RIP-relative `lea`.  If it landed farther away, the last
;     instruction falls back to an absolute `mov rax, imm64` (10 B, 18 total), so
;     the result is correct regardless of where the region was reserved.
;     Opt-in only: the programmer tags variables that are hot in an inner loop,
;     so the larger-than-a-CALL body is paid only where it pays off.
proc(inline_var_comp)
    mov     r8, [UP + user_HERE]
    mov     rcx, [rax + 6]                   ; body address = stub's baked imm64
    mov     byte ptr [r8 + 0], 0x48          ; mov [rbp-8], rax
    mov     byte ptr [r8 + 1], 0x89
    mov     byte ptr [r8 + 2], 0x45
    mov     byte ptr [r8 + 3], 0xF8
    mov     byte ptr [r8 + 4], 0x48          ; sub rbp, 8
    mov     byte ptr [r8 + 5], 0x83
    mov     byte ptr [r8 + 6], 0xED
    mov     byte ptr [r8 + 7], 0x08

    ; Pick the address form. A RIP-relative `lea` (48 8D 05 disp32) is 7 bytes
    ; and would sit at r8+8, so its disp32 is measured from r8+15 (the IP just
    ; after it). Use it when that displacement fits in signed 32 bits.
    lea     rdx, [r8 + 15]                   ; IP after a 7-byte lea at r8+8
    mov     r9, rcx
    sub     r9, rdx                          ; r9 = disp = body - next_ip
    movsxd  r10, r9d                         ; sign-extend low 32 bits
    cmp     r10, r9                          ; fits in signed 32-bit?
    jne     .far                             ; no -> absolute imm64 fallback

    mov     byte ptr [r8 + 8], 0x48          ; lea rax, [rip + disp32]
    mov     byte ptr [r8 + 9], 0x8D
    mov     byte ptr [r8 + 10], 0x05
    mov     dword ptr [r8 + 11], r9d         ; disp32 = body - next_ip
    add     r8, 15
    ; ADDR watermark — RIP/lea form is fusable by a following @ / !
    mov     [UP + user_LAST_ADDR_END], r8
    lea     rdx, [r8 - 15]
    mov     [UP + user_LAST_ADDR_START], rdx
    mov     [UP + user_LAST_ADDR_BODY], rcx
    jmp     .emitted

.far:
    mov     byte ptr [r8 + 8], 0x48          ; mov rax, imm64
    mov     byte ptr [r8 + 9], 0xB8
    mov     [r8 + 10], rcx                   ; imm64 = body address (data region)
    add     r8, 18
    mov     qword ptr [UP + user_LAST_ADDR_END], 0   ; absolute form: not fusable

.emitted:
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-rot,  ( xt -- )   rot ( n1 n2 n3 -- n2 n3 n1 ), mirrors proc(rot_).
proc(inline_rot_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov rcx, [rbp]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x4D
    mov     byte ptr [r8 + 3], 0x00
    mov     byte ptr [r8 + 4], 0x48          ; mov rdx, [rbp+8]
    mov     byte ptr [r8 + 5], 0x8B
    mov     byte ptr [r8 + 6], 0x55
    mov     byte ptr [r8 + 7], 0x08
    mov     byte ptr [r8 + 8], 0x48          ; mov [rbp], rax
    mov     byte ptr [r8 + 9], 0x89
    mov     byte ptr [r8 + 10], 0x45
    mov     byte ptr [r8 + 11], 0x00
    mov     byte ptr [r8 + 12], 0x48         ; mov [rbp+8], rcx
    mov     byte ptr [r8 + 13], 0x89
    mov     byte ptr [r8 + 14], 0x4D
    mov     byte ptr [r8 + 15], 0x08
    mov     byte ptr [r8 + 16], 0x48         ; mov rax, rdx
    mov     byte ptr [r8 + 17], 0x89
    mov     byte ptr [r8 + 18], 0xD0
    add     r8, 19
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline--rot,  ( xt -- )   -rot ( n1 n2 n3 -- n3 n1 n2 ), mirrors proc(neg_rot).
proc(inline_neg_rot_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov rcx, [rbp+8]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x4D
    mov     byte ptr [r8 + 3], 0x08
    mov     byte ptr [r8 + 4], 0x48          ; mov rdx, [rbp]
    mov     byte ptr [r8 + 5], 0x8B
    mov     byte ptr [r8 + 6], 0x55
    mov     byte ptr [r8 + 7], 0x00
    mov     byte ptr [r8 + 8], 0x48          ; mov [rbp+8], rax
    mov     byte ptr [r8 + 9], 0x89
    mov     byte ptr [r8 + 10], 0x45
    mov     byte ptr [r8 + 11], 0x08
    mov     byte ptr [r8 + 12], 0x48         ; mov [rbp], rcx
    mov     byte ptr [r8 + 13], 0x89
    mov     byte ptr [r8 + 14], 0x4D
    mov     byte ptr [r8 + 15], 0x00
    mov     byte ptr [r8 + 16], 0x48         ; mov rax, rdx
    mov     byte ptr [r8 + 17], 0x89
    mov     byte ptr [r8 + 18], 0xD0
    add     r8, 19
    mov     [UP + user_HERE], r8
    mov     qword ptr [UP + user_TAIL_CALL], 0
    mov     TOS, [DSP]
    stk(1, 0)
    next()
endp()

; inline-nip,  ( xt -- )    nip ( a b -- b ) = drop NOS = `add rbp, 8`.
proc(inline_nip_comp)
    mov     r8, [UP + user_HERE]
