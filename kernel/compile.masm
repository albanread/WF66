; inline-c!,  ( xt -- )     c! ( byte addr -- ), mirrors proc(c_store).
proc(inline_c_store_comp)
    mov     r8, [UP + user_HERE]
    mov     byte ptr [r8 + 0], 0x48          ; mov rcx, [rbp]
    mov     byte ptr [r8 + 1], 0x8B
    mov     byte ptr [r8 + 2], 0x4D
    mov     byte ptr [r8 + 3], 0x00
    mov     byte ptr [r8 + 4], 0x88          ; mov [rax], cl
    mov     byte ptr [r8 + 5], 0x08
    mov     byte ptr [r8 + 6], 0x48          ; mov rax, [rbp+8]
    mov     byte ptr [r8 + 7], 0x8B
    mov     byte ptr [r8 + 8], 0x45
    mov     byte ptr [r8 + 9], 0x08
    mov     byte ptr [r8 + 10], 0x48         ; add rbp, 16
    mov     byte ptr [r8 + 11], 0x83
    mov     byte ptr [r8 + 12], 0xC5
    mov     byte ptr [r8 + 13], 0x10
    add     r8, 14
    mov     [UP + user_HERE], r8
